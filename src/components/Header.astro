---
import { languages, type Locale, getTranslations, getLocalePath } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const currentLocaleInfo = languages[lang];
---

<header
  class="sticky top-0 z-50 w-full h-[var(--header-height)] bg-bgPrimary/95 backdrop-blur-md border-b-2 border-borderTheme/40 transition-colors duration-200"
>
  <div class="max-w-7xl mx-auto h-full px-2.5 sm:px-4 lg:px-6 flex items-center justify-between gap-1.5 sm:gap-2 lg:gap-4">
    <!-- 1. Brand Logo + Title (Icon-only 48x48 on Mobile & Tablet <1024px, Full Title on Desktop >=1024px) -->
    <a
      href={getLocalePath(lang)}
      aria-label={t.nav.brandTitle}
      class="group flex items-center gap-2.5 sm:gap-3 min-w-[48px] min-h-[48px] rounded-2xl p-1 lg:px-2.5 lg:py-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-btnPrimary transition-transform active:scale-95 shrink-0"
    >
      <div
        class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-btnPrimary text-btnPrimaryText flex items-center justify-center shadow-md group-hover:bg-btnPrimaryHover transition-colors shrink-0"
      >
        <!-- Crisp Video Film Swap SVG Icon -->
        <svg
          class="w-6 h-6 sm:w-7 sm:h-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" rx="3" />
          <path d="M10 9l5 3-5 3V9z" fill="currentColor" stroke="none" />
          <path d="M2 8h3M2 12h3M2 16h3M19 8h3M19 12h3M19 16h3" />
        </svg>
      </div>
      <div class="hidden lg:flex flex-col">
        <span class="text-xl font-extrabold tracking-tight text-textPrimary leading-none">
          {t.nav.brandTitle}
        </span>
        <span class="text-xs font-semibold text-textSecondary tracking-wider uppercase mt-1">
          {t.nav.brandSubtitle}
        </span>
      </div>
    </a>

    <!-- Right Action Bar: Ultra-Minimal 48x48 Icon-Only on Mobile & Tablet (<1024px), Full Labels on Desktop (>=1024px) -->
    <nav class="flex items-center gap-1.5 sm:gap-2 lg:gap-2.5" aria-label="Primary Navigation">
      <!-- 2. 8-Language Dropdown Selector -->
      <div class="relative" id="lang-dropdown-wrapper">
        <button
          type="button"
          id="lang-dropdown-btn"
          aria-label={t.nav.languageLabel}
          aria-haspopup="true"
          aria-expanded="false"
          title={t.nav.languageLabel}
          class="min-w-[48px] min-h-[48px] p-2.5 lg:px-3.5 rounded-2xl border-2 border-borderTheme/60 bg-workspaceBg hover:border-btnPrimary text-textPrimary flex items-center justify-center gap-2 font-bold text-base transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-btnPrimary shrink-0"
        >
          <!-- Globe SVG Icon -->
          <svg
            class="w-6 h-6 text-textSecondary shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
            <path d="M2 12h20" />
          </svg>
          <span class="hidden lg:inline font-bold">{currentLocaleInfo.short}</span>
          <svg
            class="hidden lg:inline w-4 h-4 text-textSecondary transition-transform duration-200"
            id="lang-chevron"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>

        <!-- Dropdown Menu (8 Languages) -->
        <div
          id="lang-dropdown-menu"
          role="menu"
          aria-label={t.nav.languageLabel}
          class="hidden absolute right-0 mt-2 w-52 max-w-[90vw] rounded-2xl bg-workspaceBg border-2 border-borderTheme shadow-2xl py-2 z-50"
        >
          {
            Object.entries(languages).map(([code, info]) => {
              const isActive = code === lang;
              return (
                <a
                  href={getLocalePath(code as Locale)}
                  role="menuitem"
                  hreflang={code}
                  class:list={[
                    'flex items-center justify-between px-4 py-2.5 text-base font-semibold transition-colors',
                    isActive
                      ? 'bg-badgeAccent/30 text-textPrimary font-extrabold'
                      : 'text-textPrimary hover:bg-badgeAccent/15',
                  ]}
                >
                  <span class="flex items-center gap-2.5">
                    <span class="text-lg" aria-hidden="true">{info.flag}</span>
                    <span>{info.name}</span>
                  </span>
                  <span class="text-xs font-mono uppercase px-1.5 py-0.5 rounded bg-bgSurface/50 text-textPrimary">
                    {info.short}
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>

      <!-- 3. Light/Dark Mode Toggle Button -->
      <button
        type="button"
        id="theme-toggle-btn"
        aria-label={t.nav.themeToggleLabel}
        title={t.nav.themeToggleLabel}
        class="min-w-[48px] min-h-[48px] p-2.5 lg:px-3.5 rounded-2xl border-2 border-borderTheme/60 bg-workspaceBg hover:border-btnPrimary text-textPrimary flex items-center justify-center gap-2 font-bold text-base transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-btnPrimary shrink-0"
      >
        <!-- Sun Icon (shown in Dark Mode) -->
        <svg
          id="theme-icon-sun"
          class="hidden w-6 h-6 text-[#D9D28B] shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <!-- Moon Icon (shown in Light Mode) -->
        <svg
          id="theme-icon-moon"
          class="w-6 h-6 text-textSecondary shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
        <span
          id="theme-toggle-text"
          class="hidden lg:inline text-sm font-bold"
          data-light={t.nav.themeLight}
          data-dark={t.nav.themeDark}
        >
          {t.nav.themeDark}
        </span>
      </button>

      <!-- 4. Install PWA Button ('Add to Home Screen') -->
      <button
        type="button"
        id="install-pwa-btn"
        aria-label={t.nav.installPwa}
        title={t.nav.installPwaTooltip}
        data-install-msg={t.toasts.pwaInstallPrompt}
        data-installed-label={t.nav.installPwaInstalled}
        class="min-w-[48px] min-h-[48px] p-2.5 lg:px-3.5 rounded-2xl border-2 border-borderTheme/60 bg-workspaceBg hover:border-btnPrimary text-textPrimary flex items-center justify-center gap-2 font-bold text-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-btnPrimary shrink-0"
      >
        <!-- Install App / Add to Home Screen SVG Icon -->
        <svg
          class="w-6 h-6 text-textSecondary shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
          <path d="M12 18h.01" />
          <path d="M12 8v6" />
          <path d="m9 11 3 3 3-3" />
        </svg>
        <span class="hidden lg:inline whitespace-nowrap" id="install-pwa-label">
          {t.nav.installPwa}
        </span>
      </button>

      <!-- 5. CTA Button: 'Support the Developer' linking to https://ko-fi.com/kishara (#D9D28B / #2C3527 contrast + heart icon) -->
      <a
        href="https://ko-fi.com/kishara"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.nav.supportDeveloper}
        title={t.nav.supportDeveloper}
        class="min-w-[48px] min-h-[48px] p-2.5 lg:px-4 rounded-2xl bg-[#D9D28B] hover:bg-[#B2BD7E] text-[#2C3527] border-2 border-[#8E9162] font-extrabold text-sm flex items-center justify-center gap-2 shadow-sm hover:shadow-md transition-all active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#6A795D] shrink-0"
      >
        <!-- Crisp Heart SVG Icon -->
        <svg
          class="w-6 h-6 text-[#2C3527] fill-[#6A795D] shrink-0 transition-transform group-hover:scale-110"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
        </svg>
        <span class="hidden lg:inline whitespace-nowrap">{t.nav.supportDeveloper}</span>
      </a>
    </nav>
  </div>
</header>

<script>
  function initHeaderControls() {
    // Language Dropdown Toggle
    const langBtn = document.getElementById('lang-dropdown-btn');
    const langMenu = document.getElementById('lang-dropdown-menu');
    const langChevron = document.getElementById('lang-chevron');

    if (langBtn && langMenu) {
      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = langMenu.classList.contains('hidden');
        langMenu.classList.toggle('hidden', !isHidden);
        langBtn.setAttribute('aria-expanded', String(isHidden));
        if (langChevron) {
          langChevron.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
        }
      });

      document.addEventListener('click', (e) => {
        if (!langMenu.contains(e.target as Node) && e.target !== langBtn) {
          langMenu.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
          if (langChevron) langChevron.style.transform = 'rotate(0deg)';
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          langMenu.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
          if (langChevron) langChevron.style.transform = 'rotate(0deg)';
        }
      });
    }

    // Theme Switcher
    const themeBtn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-toggle-text');

    function syncThemeUI() {
      const isDark = document.documentElement.classList.contains('dark');
      if (sunIcon && moonIcon) {
        sunIcon.classList.toggle('hidden', !isDark);
        moonIcon.classList.toggle('hidden', isDark);
      }
      if (themeText) {
        const lightLabel = themeText.getAttribute('data-light') || 'Light';
        const darkLabel = themeText.getAttribute('data-dark') || 'Dark';
        themeText.textContent = isDark ? lightLabel : darkLabel;
      }
    }

    syncThemeUI();

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch {}
        syncThemeUI();
      });
    }

    // Install PWA ("Add to Home Screen")
    let deferredPrompt: any = null;
    const installBtn = document.getElementById('install-pwa-btn');
    const installLabel = document.getElementById('install-pwa-label');

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
    });

    window.addEventListener('appinstalled', () => {
      deferredPrompt = null;
      if (installLabel && installBtn) {
        installLabel.textContent =
          installBtn.getAttribute('data-installed-label') || 'App Ready Offline';
      }
    });

    async function handlePwaInstallRequest() {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        await deferredPrompt.userChoice;
        deferredPrompt = null;
      } else {
        window.dispatchEvent(new CustomEvent('open-pwa-modal'));
      }
    }

    (window as any).__triggerPwaInstall = handlePwaInstallRequest;

    if (installBtn) {
      installBtn.addEventListener('click', handlePwaInstallRequest);
    }
  }

  initHeaderControls();
</script>
