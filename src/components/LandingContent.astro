---
import ConverterHero from './ConverterHero.astro';
import { type Locale, getTranslations, getLocalePath, MANDATORY_SEO_KEYWORDS } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<!-- 100% First Fold (100dvh) Dedicated Strictly to the Interactive MOV-to-MP4 Converter Box Div -->
<ConverterHero lang={lang} />

<!-- Strictly Below-the-Fold Semantic SEO Architecture -->
<div class="max-w-5xl mx-auto px-3 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-12 sm:space-y-16 border-t-2 border-borderTheme/30">
  <!-- Semantic Breadcrumb Navigation Right Below First-Fold Hero Workspace -->
  <nav
    aria-label="Breadcrumb"
    class="rounded-xl sm:rounded-2xl bg-workspaceBg border border-borderTheme/50 px-3.5 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-bold text-textSecondary inline-flex items-center shadow-sm"
  >
    <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2">
      <li class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-btnPrimary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          <polyline points="9 22 9 12 15 12 15 22" />
        </svg>
        <a href={getLocalePath(lang)} class="hover:text-textPrimary underline decoration-borderTheme">
          {t.breadcrumbs.home}
        </a>
      </li>
      <li aria-hidden="true" class="text-borderTheme">/</li>
      <li class="text-textPrimary font-extrabold" aria-current="page">
        {t.breadcrumbs.converter}
      </li>
    </ol>
  </nav>

  <!-- SECTION 1: 3-Step Visual Guide for MOV to MP4 & MP4 to MOV -->
  <section id="how-to-convert" aria-labelledby="howto-heading" class="space-y-6 sm:space-y-8">
    <div class="text-center max-w-3xl mx-auto px-1">
      <h2 id="howto-heading" class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-extrabold text-textPrimary tracking-tight">
        {t.howTo.sectionTitle}
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-textSecondary mt-2 sm:mt-3">
        {t.howTo.sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      {
        [
          { num: '01', title: t.howTo.step1Title, desc: t.howTo.step1Desc },
          { num: '02', title: t.howTo.step2Title, desc: t.howTo.step2Desc },
          { num: '03', title: t.howTo.step3Title, desc: t.howTo.step3Desc },
        ].map((step) => (
          <article class="rounded-2xl sm:rounded-3xl bg-workspaceBg border-2 border-borderTheme p-4 sm:p-6 md:p-7 flex flex-col gap-2.5 sm:gap-3.5 shadow-sm hover:border-btnPrimary transition-colors">
            <div class="flex items-center justify-between">
              <span class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-bgSurface text-[#2C3527] dark:text-[#D9D28B] border-2 border-borderTheme font-mono font-extrabold text-base sm:text-lg flex items-center justify-center shrink-0">
                {step.num}
              </span>
              <span class="text-[11px] sm:text-xs font-mono font-extrabold uppercase px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full bg-bgPrimary text-textSecondary border border-borderTheme/50">
                MOV ↔ MP4
              </span>
            </div>
            <h3 class="text-lg sm:text-xl font-extrabold text-textPrimary leading-snug">{step.title}</h3>
            <p class="text-xs sm:text-sm md:text-base text-textSecondary leading-relaxed">{step.desc}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- SECTION 2: Why Local Browser Conversion Beats CloudConvert MOV to MP4 (Zero Upload Limits) -->
  <section id="cloudconvert-comparison" aria-labelledby="comparison-heading" class="space-y-6 sm:space-y-8">
    <div class="text-center max-w-3xl mx-auto px-1">
      <span class="inline-block px-3 sm:px-4 py-0.5 sm:py-1 rounded-full text-[10px] sm:text-xs font-extrabold uppercase tracking-wider bg-bgSurface text-[#2C3527] dark:text-[#D9D28B] border border-borderTheme mb-2 sm:mb-3">
        {t.cloudComparison.badge}
      </span>
      <h2 id="comparison-heading" class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-extrabold text-textPrimary tracking-tight">
        {t.cloudComparison.sectionTitle}
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-textSecondary mt-2 sm:mt-3 leading-relaxed">
        {t.cloudComparison.sectionSubtitle}
      </p>
    </div>

    <!-- Comparison Card -->
    <div class="rounded-2xl sm:rounded-[2rem] bg-workspaceBg border-2 border-borderTheme p-4 sm:p-6 md:p-8 shadow-workspace dark:shadow-workspaceDark space-y-4 sm:space-y-6">
      <div class="space-y-1.5 sm:space-y-2">
        <h3 class="text-lg sm:text-xl md:text-2xl font-extrabold text-textPrimary">
          {t.cloudComparison.cardTitle}
        </h3>
        <p class="text-xs sm:text-sm md:text-base text-textSecondary leading-relaxed">
          {t.cloudComparison.cardDesc}
        </p>
      </div>

      <!-- Responsive Comparison Table -->
      <div class="overflow-x-auto -mx-1 sm:mx-0 rounded-xl sm:rounded-2xl border-2 border-borderTheme/70">
        <table class="w-full text-left border-collapse min-w-[480px]">
          <thead>
            <tr class="bg-bgSurface/70 dark:bg-bgSurface text-[#2C3527] dark:text-[#D9D28B] border-b-2 border-borderTheme/70">
              <th class="py-2.5 sm:py-3.5 px-3 sm:px-6 font-extrabold text-xs sm:text-base">Feature</th>
              <th class="py-2.5 sm:py-3.5 px-3 sm:px-6 font-extrabold text-xs sm:text-base text-[#2C3527] dark:text-[#D9D28B]">
                ⚡ {t.cloudComparison.localHeader}
              </th>
              <th class="py-2.5 sm:py-3.5 px-3 sm:px-6 font-bold text-xs sm:text-base opacity-85">
                ☁️ {t.cloudComparison.cloudHeader}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-borderTheme/30 text-xs sm:text-sm md:text-base">
            {
              t.cloudComparison.rows.map((row) => (
                <tr class="bg-workspaceBg hover:bg-bgPrimary/60 transition-colors">
                  <td class="py-2.5 sm:py-3.5 px-3 sm:px-6 font-extrabold text-textPrimary">{row.feature}</td>
                  <td class="py-2.5 sm:py-3.5 px-3 sm:px-6 font-bold text-[#6A795D] dark:text-[#B2BD7E]">
                    ✓ {row.localValue}
                  </td>
                  <td class="py-2.5 sm:py-3.5 px-3 sm:px-6 text-textSecondary">{row.cloudValue}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <!-- Keyword Matrix Callout Box -->
      <div class="rounded-xl sm:rounded-2xl bg-bgPrimary border border-borderTheme/60 p-3.5 sm:p-5 space-y-2.5 sm:space-y-3">
        <h3 class="text-base sm:text-lg font-extrabold text-textPrimary">
          {t.cloudComparison.keywordCalloutTitle}
        </h3>
        <p class="text-xs sm:text-sm md:text-base text-textSecondary leading-relaxed">
          {t.cloudComparison.keywordCalloutBody}
        </p>
        <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-0.5" aria-label="Supported Video Conversion Keywords">
          {
            MANDATORY_SEO_KEYWORDS.map((kw) => (
              <span class="px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full text-[10px] sm:text-xs font-mono font-bold bg-workspaceBg text-textSecondary border border-borderTheme/50">
                {kw}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: Core Technical Features -->
  <section id="features" aria-labelledby="features-heading" class="space-y-6 sm:space-y-8">
    <div class="text-center max-w-3xl mx-auto px-1">
      <h2 id="features-heading" class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-extrabold text-textPrimary tracking-tight">
        {t.features.sectionTitle}
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-textSecondary mt-2">
        {t.features.sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      {
        [
          { title: t.features.f1Title, desc: t.features.f1Desc },
          { title: t.features.f2Title, desc: t.features.f2Desc },
          { title: t.features.f3Title, desc: t.features.f3Desc },
          { title: t.features.f4Title, desc: t.features.f4Desc },
        ].map((feat) => (
          <div class="rounded-2xl sm:rounded-3xl bg-workspaceBg border-2 border-borderTheme p-4 sm:p-6 md:p-7 space-y-2 sm:space-y-2.5 shadow-sm">
            <h3 class="text-lg sm:text-xl font-extrabold text-textPrimary">{feat.title}</h3>
            <p class="text-xs sm:text-sm md:text-base text-textSecondary leading-relaxed">{feat.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- SECTION 4: High-Intent FAQ Accordion Incorporating All 13 Target Keywords -->
  <section id="faq" aria-labelledby="faq-heading" class="space-y-6 sm:space-y-8">
    <div class="text-center max-w-3xl mx-auto px-1">
      <h2 id="faq-heading" class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-extrabold text-textPrimary tracking-tight">
        {t.faq.sectionTitle}
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-textSecondary mt-2">
        {t.faq.sectionSubtitle}
      </p>
    </div>

    <div class="space-y-3 sm:space-y-4">
      {
        t.faq.items.map((item, idx) => (
          <details
            class="group rounded-xl sm:rounded-2xl bg-workspaceBg border-2 border-borderTheme p-4 sm:p-5 md:p-6 transition-all"
            open={idx === 0}
          >
            <summary class="flex items-center justify-between gap-3 sm:gap-4 cursor-pointer list-none font-extrabold text-base sm:text-lg text-textPrimary">
              <h3 class="text-base sm:text-lg font-extrabold text-textPrimary inline leading-snug">{item.q}</h3>
              <span
                aria-hidden="true"
                class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg sm:rounded-xl bg-bgPrimary border border-borderTheme flex items-center justify-center text-textSecondary group-open:rotate-180 transition-transform shrink-0"
              >
                ↓
              </span>
            </summary>
            <p class="mt-2.5 sm:mt-3 text-xs sm:text-sm md:text-base text-textSecondary leading-relaxed border-t border-borderTheme/30 pt-2.5 sm:pt-3">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </section>
</div>
