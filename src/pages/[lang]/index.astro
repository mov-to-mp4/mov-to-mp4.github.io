---
import Layout from '../../layouts/Layout.astro';
import LandingContent from '../../components/LandingContent.astro';
import { localeList, defaultLocale, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return localeList
    .filter((loc) => loc !== defaultLocale)
    .map((loc) => ({
      params: { lang: loc },
      props: { lang: loc },
    }));
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<Layout lang={lang}>
  <LandingContent lang={lang} />
</Layout>
